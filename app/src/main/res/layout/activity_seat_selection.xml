<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:title="Select Seat"
        app:titleTextColor="@color/agoda_blue"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/agoda_blue" />

    <!-- Legend -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp">
        <View android:layout_width="16dp" android:layout_height="16dp" android:background="@color/gray_300" android:layout_marginEnd="4dp"/>
        <TextView android:text="Taken" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="16dp"/>
        <View android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/bg_seat_available" android:layout_marginEnd="4dp"/>
        <TextView android:text="Available" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="16dp"/>
        <View android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/bg_seat_selected" android:layout_marginEnd="4dp"/>
        <TextView android:text="Selected" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSeats"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false" />

    <!-- Summary Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/gray_100"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvSelectedSeat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Selected: None"
            android:textStyle="bold"
            android:textColor="@color/agoda_blue"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirm Seat" />
    </LinearLayout>
</LinearLayout>