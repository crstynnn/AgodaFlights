<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AgodaApp" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary colors -->
        <item name="colorPrimary">@color/agoda_blue</item>
        <item name="colorPrimaryVariant">@color/agoda_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/agoda_blue</item>
        <item name="colorSecondaryVariant">@color/agoda_blue_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background colors -->
        <item name="android:windowBackground">@color/white</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/gray_900</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Default Styles -->
        <item name="textInputStyle">@style/Widget.Agoda.TextInputLayout</item>
        <item name="materialButtonStyle">@style/Widget.Agoda.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Agoda.CardView</item>
        <item name="toolbarStyle">@style/Widget.Agoda.Toolbar</item>
    </style>

    <style name="Widget.Agoda.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/white</item>
        <item name="titleTextColor">@color/agoda_blue</item>
        <item name="subtitleTextColor">@color/gray_600</item>
        <item name="navigationIconTint">@color/agoda_blue</item>
    </style>

    <style name="Widget.Agoda.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <style name="Widget.Agoda.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/agoda_blue</item>
        <item name="hintTextColor">@color/agoda_blue</item>
        <item name="android:textColorHint">@color/gray_600</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>

    <style name="Widget.Agoda.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="CircleImageView" parent="">
        <item name="cornerSize">50%</item>
    </style>
</resources>